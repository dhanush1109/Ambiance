{
  "appId": "com.ambiance.hycross",
  "appName": "Ambiance",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "backgroundColor": "#000000",
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
